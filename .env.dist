API_URL=http://localhost:3000
API_TOKEN=

# Mount della share. In produzione e' in lettura-scrittura: questo e' l'unico
# componente che scrive sulla share (thumbnail e cestino).
MEDIA_ROOT=/data/photos

LOG_LEVEL=info

# Un'immagine da 24 MP decodificata in RGBA occupa 96 MB: con 3 worker piu'
# l'headroom del GC si sta sotto il limite del pod.
SCAN_WORKERS=3

# Obbligatorio: il GC di Go non conosce i limiti cgroup e senza questo cresce
# oltre il limite del pod finche' non viene OOMKillato a meta' scansione.
GOMEMLIMIT=800MiB

# Root creata automaticamente al primo avvio se non ne esiste nessuna.
# ROOT_REL_PATH e' relativo a MEDIA_ROOT: vuoto = la radice della share.
ROOT_NAME=Foto
ROOT_REL_PATH=
